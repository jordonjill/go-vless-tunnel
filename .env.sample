# VLESS UUID (required)
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UUID=

# Server port (optional)
# Range: 1-65535
PORT=3182

# Tunnel domain (required)
# Example: example.com
TUNNEL_DOMAIN=

# Cloudflare Tunnel token (required)
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# Server name (optional)
# Defaults to hostname
NAME=

# WebSocket path prefix (optional)
# Defaults to /work-tunnel-
VLESS_PATH_PREFIX=